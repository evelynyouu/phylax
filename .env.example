# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only, used for account deletion and nothing else)
SUPABASE_SERVICE_ROLE_KEY=
# 64 hex chars, encrypts stored Gmail tokens (required outside demo mode)
TOKEN_ENC_KEY=
# Google OAuth client id
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# Public base URL of the app, e.g. http://127.0.0.1:3000
APP_URL=
# Integration tests only: first test user's email
SUPABASE_TEST_EMAIL_A=
# Integration tests only: second test user's email
SUPABASE_TEST_EMAIL_B=
# Integration tests only: password shared by both test users
SUPABASE_TEST_PASSWORD=
